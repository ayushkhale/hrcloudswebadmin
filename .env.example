# ─────────────────────────────────────────────────────────────────────────────
# HR Clouds — Control Plane
# Copy to `.env.development` / `.env.production`. Never commit a filled-in copy.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the API gateway, no trailing slash.
# The product's own gateway is https://development.hrclouds.in/api/v1 — but the
# console needs the PLATFORM plane (`/api/v1/platform/*`), which does not exist
# yet (see docs/CONTROL_PLANE_VISION.md §4). Leave blank and the console signs in
# locally so the UI can be walked without a backend.
VITE_API_BASE_URL=
