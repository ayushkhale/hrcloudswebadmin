# Where the HR Clouds API lives. INCLUDE the version segment — HR Clouds Web
# sets it the same way, so a path in an api module reads "/platform/me" and
# lines up with the "/api/v1/platform/me" written in the API docs.
#   local backend   http://localhost:4500/api/v1
#   development     https://development.hrclouds.in/api/v1
#   production      https://api.hrclouds.in/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Reads that have no endpoint yet resolve from src/data/sample.js while this
# is true. Phase 1 (#281 GET /platform/me) IS built on the backend, so set
# this to "false" to sign in against a real server; the rest of the console
# still falls back to sample numbers until its own phases ship.
VITE_USE_SAMPLE_DATA=true
